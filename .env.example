# Instagram Reels Pipeline — environment variables
# Copy to .env and fill in values. Never commit .env.
#
# Used locally for reference; n8n Cloud stores secrets in Credentials (Phase 3).
# See build/n8n-credentials-map.md for how each value maps to n8n.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project ref = subdomain in https://<ref>.supabase.co
SUPABASE_PROJECT_REF=fahosgalmjfxpijzjplf
# Settings → API → service_role (secret — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# Profile → API Keys
ELEVENLABS_API_KEY=
# Voice Library → pick ONE voice → copy Voice ID (keep consistent forever)
ELEVENLABS_VOICE_ID=

# ── Mapbox ────────────────────────────────────────────────────────────────────
# account.mapbox.com → Access tokens → public token (pk.*)
MAPBOX_PUBLIC_TOKEN=

# ── Creatomate ────────────────────────────────────────────────────────────────
# Project Settings → API key
CREATOMATE_API_KEY=
# Templates → your 1080×1920 reel template → ID from URL or template settings
CREATOMATE_TEMPLATE_ID=

# ── Telegram ──────────────────────────────────────────────────────────────────
# @BotFather → /newbot → bot token
TELEGRAM_BOT_TOKEN=
# Message your bot once, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# ── Meta / Instagram Graph API v21.0 ─────────────────────────────────────────
# From GET /{page-id}?fields=instagram_business_account
IG_USER_ID=
# Long-lived user access token (~60 days); refresh before expiry
META_ACCESS_TOKEN=
